{
  "name": "@di-framework/plugin",
  "version": "1.0.0",
  "description": "Antigravity Agent Plugin & MCP Server for di-framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "di-framework-plugin": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "plugin.json",
    "mcp_config.json",
    "rules",
    "skills",
    "contracts",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "bun build src/index.ts --outdir ./dist --target node && bun build bin/cli.ts --outdir ./dist/bin --target node && tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "openapi:types": "openapi-typescript ./contracts/openapi.json -o ./src/contracts/search-api.ts",
    "check": "bun test",
    "check:examples": "tsc -p skills/tsconfig.json && bun test src/tools/framework-examples.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/di-framework/plugin.git"
  },
  "bugs": {
    "url": "https://github.com/di-framework/plugin/issues"
  },
  "homepage": "https://docs.di-framework.dev",
  "keywords": [
    "di-framework",
    "antigravity",
    "agent-plugin",
    "mcp",
    "skills",
    "model-context-protocol"
  ],
  "license": "(MIT OR Apache-2.0)",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@di-framework/auth": "5.3.0",
    "@di-framework/authz": "5.3.0",
    "@di-framework/core": "5.3.0",
    "@di-framework/http": "5.3.0",
    "@di-framework/repo": "5.3.0",
    "@di-framework/rpc": "5.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
